# ─────────────────────────────────────────────────────────────
# Trading mode. "test" → simulated paper trading (no real money).
# "live" would route through a real exchange adapter (not wired yet).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TRADING_MODE=test

# Target exchange for the data/domain model. Currently: upbit.
NEXT_PUBLIC_EXCHANGE=upbit

# ── Real Upbit keys — ONLY needed once you flip to LIVE mode. ──
# Server-only (no NEXT_PUBLIC_ prefix) so they NEVER reach the browser bundle.
# Issue at https://upbit.com/mypage/open_api_management — grant "자산 조회" +
# "주문" permissions, and ideally restrict to your IP. Leave blank in test mode.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ── Live-trading hard safety rails (enforced server-side) ──
# Max KRW per single buy order. Orders above this are rejected outright.
UPBIT_MAX_ORDER_KRW=20000
# Max cumulative KRW spent on buys per (UTC) day. Server blocks once reached.
UPBIT_DAILY_CAP_KRW=50000

# ── Auth (better-auth) ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Signup cap (1 = operator only)
MAX_USERS=1
# Social login — activate by filling these (issued from each provider console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
